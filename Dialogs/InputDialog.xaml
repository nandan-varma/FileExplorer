<Window x:Class="FileBrowser.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FileBrowser.Converters"
        Title="{Binding Title}"
        Height="160" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        Foreground="WhiteSmoke"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Text="{Binding Prompt}"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Padding="6,4" FontSize="13"
                 Background="#FF2D2D30" Foreground="WhiteSmoke"
                 BorderBrush="#FF3F3F46" CaretBrush="WhiteSmoke"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InputBox_KeyDown"/>

        <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#FFE06C75"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" FontSize="11"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="28" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="28" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
