<Window x:Class="FileBrowser.Dialogs.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        Foreground="WhiteSmoke"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding TypeText}" Grid.Row="0" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Location:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding LocationText}" Grid.Row="1" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding SizeText}" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Created:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding CreatedText}" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Modified:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding ModifiedText}" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Attributes:" Foreground="#FFAAAAAA" Margin="0,4"/>
            <TextBlock Text="{Binding AttributesText}" Grid.Row="5" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
        </Grid>

        <Button Grid.Row="2" Content="Close" Width="90" Height="28" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
    </Grid>
</Window>
