<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Win32Resource />
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.VisualBasic.FileIO.FileSystem sends deletes to the Recycle Bin
         with the native Explorer confirmation UI - there's no first-class System.IO
         equivalent, so this is the standard way to get that behavior from .NET. -->
    <PackageReference Include="Microsoft.VisualBasic" Version="10.4.0" />
  </ItemGroup>

</Project>
